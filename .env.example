#####################################################################
# Copy this file to `.env` at the repository root, then fill values.
#
# This file is used by `docker compose` (see docker-compose.yml `env_file`)
# and is also read by the FastAPI/Celery app via pydantic-settings.
#####################################################################

# -------------------------
# Core infrastructure
# -------------------------
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/multiagent_db
REDIS_URL=redis://redis:6379/0

# Optional API key for protecting endpoints (recommended for deployments)
# If empty, requests are allowed (local dev only).
API_KEY=

# development | production — production requires API_KEY + GITHUB_WEBHOOK_SECRET
ENVIRONMENT=development

# Set false in production to hide /docs
EXPOSE_DOCS=true

# Rate limiting (Redis-backed)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30

# Comma-separated repos allowed for workflow/indexing (empty = all repos token can access)
REPO_ALLOWLIST=

# Reject webhooks when GITHUB_WEBHOOK_SECRET is unset
REQUIRE_WEBHOOK_SECRET=false

# SQLAlchemy query logging
SQL_ECHO=false

# CORS origin for the frontend (optional, e.g. http://localhost:3000)
FRONTEND_ORIGIN=

# -------------------------
# GitHub
# -------------------------
# Server PAT for webhooks / API-key submissions (optional when OAuth is enabled)
GITHUB_TOKEN=

# GitHub OAuth — user sign-in; per-user repo access for submit/index
# Create an OAuth App: https://github.com/settings/developers
# Callback URL (via frontend/nginx): http://localhost:3000/api/v1/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRE_MINUTES=10080
AUTH_COOKIE_SECURE=false

# Webhook secret (recommended). Must match what you configure in GitHub.
# If empty, webhook signature verification is disabled (NOT recommended).
GITHUB_WEBHOOK_SECRET=

# -------------------------
# Groq (chat LLM: workflow plan/write/fix)
# -------------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com
GROQ_MODEL=llama-3.3-70b-versatile

# -------------------------
# Qdrant (hosted/remote)
# -------------------------
# Qdrant Cloud typically uses https and requires an API key.
# Docker Compose (local Qdrant service): use http://qdrant:6333
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=repo_code_chunks
QDRANT_TIMEOUT=120

# Optional: set only if you must match an existing collection dimension.
# If empty, dimension is inferred from the first embedding call.
QDRANT_EMBEDDING_DIM=

# -------------------------
# Ollama embeddings (indexing + Qdrant search)
# -------------------------
# NOTE: many coding/chat models do NOT support embeddings.
# embeddinggemma:300m — 768 dims, ~2K token context (`ollama pull embeddinggemma:300m`)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma:300m
# Keep ≤6000 for embeddinggemma's 2K-token window; raise for nomic-embed-text (8K tokens)
OLLAMA_EMBED_MAX_CHARS=6000

# -------------------------
# Indexing tuning (optional)
# -------------------------
INDEX_MAX_FILE_BYTES=1048576
INDEX_BLOB_FETCH_WORKERS=8
INDEX_CHUNK_MAX_LINES=400
INDEX_CHUNK_OVERLAP_LINES=0
INDEX_UPSERT_BATCH_SIZE=64

# -------------------------
# Workflow (optional)
# -------------------------
# Skip Docker test step (dev only — PRs still open). Default: false
WORKFLOW_SKIP_TESTS=false
MAX_CONTEXT_TOKENS=6000
CONTEXT_SEARCH_TOP_K=12

# -------------------------
# Sandbox runner (isolated Docker validation — only sandbox service mounts docker.sock)
# -------------------------
SANDBOX_RUNNER_URL=http://sandbox:8090
SANDBOX_RUNNER_SECRET=change-me-to-a-long-random-string
