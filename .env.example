#####################################################################
# Copy this file to `.env` at the repository root, then fill values.
#
# This file is used by `docker compose` (see docker-compose.yml `env_file`)
# and is also read by the FastAPI/Celery app via pydantic-settings.
#####################################################################

# -------------------------
# Core infrastructure
# -------------------------
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/multiagent_db
REDIS_URL=redis://redis:6379/0

# Optional API key for protecting endpoints (recommended for deployments)
# If empty, requests are allowed (local dev).
API_KEY=

# -------------------------
# GitHub
# -------------------------
# GitHub PAT with `repo` scope (or a GitHub App token if you adapt github_client)
GITHUB_TOKEN=

# Webhook secret (recommended). Must match what you configure in GitHub.
# If empty, webhook signature verification is disabled (NOT recommended).
GITHUB_WEBHOOK_SECRET=

# -------------------------
# Groq (chat LLM: workflow plan/write/fix)
# -------------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com
GROQ_MODEL=llama-3.3-70b-versatile

# -------------------------
# Qdrant (hosted/remote)
# -------------------------
# Qdrant Cloud typically uses https and requires an API key.
QDRANT_URL=https://your-qdrant-host:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=repo_code_chunks
QDRANT_TIMEOUT=120

# Optional: set only if you must match an existing collection dimension.
# If empty, dimension is inferred from the first embedding call.
QDRANT_EMBEDDING_DIM=

# -------------------------
# Ollama embeddings (indexing + Qdrant search)
# -------------------------
# NOTE: many coding/chat models do NOT support embeddings.
# Use an embedding-capable model (e.g. `nomic-embed-text`) unless verified.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# -------------------------
# Indexing tuning (optional)
# -------------------------
INDEX_MAX_FILE_BYTES=1048576
INDEX_BLOB_FETCH_WORKERS=8
INDEX_CHUNK_MAX_LINES=400
INDEX_CHUNK_OVERLAP_LINES=0
INDEX_UPSERT_BATCH_SIZE=64
